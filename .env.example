ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Comma-separated list of valid subscriber access codes.
# Leave empty (or unset) to allow unrestricted access (local dev only).
# Example: ACCESS_CODES=CLV-MARIA-9X4K,CLV-BRIAN-2P7W
ACCESS_CODES=

# Stripe — used by /api/stripe/webhook to verify and process subscriptions.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — used to email welcome messages with access codes.
RESEND_API_KEY=re_...

# Upstash Redis — auto-set by Vercel when an Upstash KV store is linked.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password for the /admin page that lists active access codes.
ADMIN_PASSWORD=
